{
  "info": {
    "name": "Petstore",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 POST /pet — создать",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 7429,\n  \"name\": \"Ника\",\n  \"status\": \"available\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/pet",
          "host": ["{{baseUrl}}"],
          "path": ["pet"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Name Ника\", function () {",
              "  pm.expect(String(pm.response.json().name)).to.include(\"Ника\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2 GET /pet/{petId} — получить",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pet/{{petId}}",
          "host": ["{{baseUrl}}"],
          "path": ["pet", "{{petId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Id 7429\", function () {",
              "  pm.expect(String(pm.response.json().id)).to.eql(\"7429\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3 PUT /pet — обновить",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 7429,\n  \"name\": \"НикаНашлаСемью\",\n  \"status\": \"sold\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/pet",
          "host": ["{{baseUrl}}"],
          "path": ["pet"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Name НикаНашлаСемью\", function () {",
              "  pm.expect(String(pm.response.json().name)).to.include(\"НикаНашлаСемью\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4 GET /pet/findByStatus — поиск",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pet/findByStatus?status=available",
          "host": ["{{baseUrl}}"],
          "path": ["pet", "findByStatus"],
          "query": [
            {
              "key": "status",
              "value": "available"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is array\", function () {",
              "  pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5 POST /store/order — создать заказ",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 8371,\n  \"petId\": 7429,\n  \"quantity\": 1,\n  \"status\": \"placed\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/store/order",
          "host": ["{{baseUrl}}"],
          "path": ["store", "order"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Status placed\", function () {",
              "  pm.expect(pm.response.json().status).to.be.oneOf([\"placed\", \"approved\"]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6 DELETE /pet/{petId} — удалить",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pet/{{petId}}",
          "host": ["{{baseUrl}}"],
          "path": ["pet", "{{petId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7 GET /pet/{petId} — негативный (после удаления)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pet/{{petId}}",
          "host": ["{{baseUrl}}"],
          "path": ["pet", "{{petId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 404\", function () {",
              "  pm.response.to.have.status(404);",
              "});",
              "pm.test(\"Pet not found\", function () {",
              "  pm.expect(pm.response.json().message).to.eql(\"Pet not found\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
